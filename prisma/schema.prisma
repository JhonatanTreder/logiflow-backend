generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoTenant {
  OPERADOR_LOGISTICO
  LOJISTA

  @@map("tipo_tenant")
}

enum StatusTenant {
  ATIVO
  INATIVO
  BLOQUEADO

  @@map("status_tenant")
}

enum Papel {
  USER
  ADMIN // Acesso ao painel da LogiFlow
  DONO_EMPRESA
  OPERADOR_EMPRESA
  OPERADOR_ARMAZEM
  DESPACHANTE
  ROTEIRIZADOR
  ENTREGADOR
  CONTADOR
  SUPORTE
  CLIENTE

  @@map("papel_usuario")
}

enum StatusUsuario {
  ATIVO
  INATIVO
  CONVIDADO
  BLOQUEADO

  @@map("status_usuario")
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  tipo            TipoTenant
  
  razaoSocial     String
  nomeFantasia    String?
  cnpj            String       @unique // Somente os 14 dígitos; validar o formato na aplicação

  status          StatusTenant @default(ATIVO)
  contatoEmail    String
  contatoTelefone String

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users User[]

  @@map("tenants")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  nome      String
  email     String // Normalizar para minúsculas na aplicação
  senhaHash String // Argon2id
  
  papel     Papel         @default(USER)
  status    StatusUsuario @default(ATIVO)

  totpAtivo         Boolean   @default(false)
  totpSecretCifrado String?
  tentativasFalhas  Int       @default(0)
  bloqueadoAte      DateTime?
  ultimoAcessoEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}